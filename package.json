{
  "name": "project-claude",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo com React (frontend) e NestJS (backend)",
  "scripts": {
    "dev:front": "pnpm --filter frontend dev",
    "dev:back": "pnpm --filter backend start:dev",
    "build:front": "pnpm --filter frontend build",
    "build:back": "pnpm --filter backend build",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build"
  }
}
